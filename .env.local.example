# Copy this file to .env.local and fill in your Firebase values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary (for admin product image uploads).
# cloud name: Cloudinary Dashboard → Account Details
# preset: Settings → Upload → Upload presets → create one with Signing Mode = Unsigned
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Catalog: anyone can read; only admins can change.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: customers can create at checkout; only admins can read/update.
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // User profiles: a user manages their own doc; admins can read all and
    // change role/disabled on anyone.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.disabled == resource.data.disabled);
    }
  }
}
